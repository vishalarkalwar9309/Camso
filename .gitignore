# =============================================================================
# CAMSO Full-Stack Project Backup — Root .gitignore
# Prevents any secrets, builds, local databases, or temporary files from commit.
# =============================================================================

# Environment & Secrets
.env
.env.*
*.env
*.env.*
*.key
*.pem
*.jks
*.keystore
google-services.json
GoogleService-Info.plist

# Database Backups & Dumps
backups/
*.dump
*.sql.gz
*.sql.bak
*.sql
!**/prisma/migrations/**/*.sql

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*

# Flutter & Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
ephemeral/
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/

# Logs & Coverage
*.log
logs/
coverage/
dist/

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.iml
